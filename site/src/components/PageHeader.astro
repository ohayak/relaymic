---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<div class="mx-auto max-w-screen-lg px-4 pb-8 pt-10 md:pb-12 md:pt-16">
  <slot name="before" />
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-[1.05] tracking-tight md:text-6xl">{title}</h1>
  {lede && <p class="lede mt-5 max-w-2xl">{lede}</p>}
  <slot />
</div>

---
// A screenshot or wireframe inside a guide (src/data/guides.json "figures").
// Rendered outside the prose styles; alt text comes from utils/media.ts for
// screenshots and from the drawing's own <title>/<desc> for wireframes.
import type { GuideFigure } from "@utils/guides";
import { alts, type MediaName } from "@utils/media";
import Wireframe from "./Wireframe.astro";
import Shot from "./Shot.astro";
import ThemedShot from "./ThemedShot.astro";
import BrowserFrame from "./BrowserFrame.astro";
import PhoneFrame from "./PhoneFrame.astro";
interface Props {
  figure: GuideFigure;
}
const { figure } = Astro.props;
const alt = (alts as Record<string, string>)[figure.name] ?? "";
const sizes = "(min-width: 1024px) 680px, 92vw";
---

<div class="not-prose my-10">
  {
    figure.kind === "wireframe" ? (
      <Wireframe name={figure.name as any} class="rounded-box border border-base-300 bg-base-100" caption={figure.caption} />
    ) : (
      <figure class="m-0">
        {figure.kind === "phone" ? (
          <div class="mx-auto w-56">
            <PhoneFrame name={figure.name as MediaName} alt={alt} sizes="224px" />
          </div>
        ) : figure.kind === "browser" ? (
          <BrowserFrame url={figure.url ?? ""}>
            <Shot name={figure.name as MediaName} alt={alt} class="block h-auto w-full" sizes={sizes} />
          </BrowserFrame>
        ) : figure.kind === "themed" ? (
          <div class={`mx-auto ${figure.name === "extension-popup" ? "max-w-[300px]" : "max-w-[440px]"}`}>
            <ThemedShot base={figure.name as "extension-consent" | "extension-popup"} alt={alt} class="h-auto w-full rounded-box border border-base-300" />
          </div>
        ) : (
          <Shot name={figure.name as MediaName} alt={alt} class="h-auto w-full rounded-box border border-base-300" sizes={sizes} />
        )}
        <figcaption class="mt-3 text-center text-sm text-base-content/75">{figure.caption}</figcaption>
      </figure>
    )
  }
</div>

---
// Renders one of src/content/legal/{privacy,terms,cookies}.md. The markdown
// starts at h2; the page's h1 is its front-matter title.
import { getEntry } from "astro:content";
import Layout from "../Layout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { publisher } from "@utils/config";
import { breadcrumbs, webPage } from "@utils/jsonld";

interface Props {
  slug: "privacy" | "terms" | "cookies";
  fallbackTitle: string;
  fallbackDescription: string;
  seoTitle: string;
}
const { slug, fallbackTitle, fallbackDescription, seoTitle } = Astro.props;
const entry = await getEntry("legal", slug);
const rendered = entry ? await entry.render() : undefined;
const title = entry?.data.title ?? fallbackTitle;
const description = entry?.data.description ?? fallbackDescription;
const updated = entry?.data.updated;
const headings = (rendered?.headings ?? []).filter((h) => h.depth === 2);
const updatedLabel = updated
  ? new Date(`${updated}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
  : undefined;
const path = `/${slug}`;
const jsonLd = [
  { ...webPage(path, title, description), ...(updated ? { dateModified: updated } : {}) },
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: title, path },
  ]),
];
---

<Layout title={seoTitle} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-screen-lg px-4 pb-10 pt-10 md:pt-16">
    <Breadcrumbs items={[{ title: "Home", href: "/" }, { title }]} />
    <h1 class="mt-6 text-4xl font-extrabold tracking-tight md:text-6xl">{title}</h1>
    {updatedLabel && <p class="mt-4 text-base-content/80">Last updated: <time datetime={updated}>{updatedLabel}</time></p>}
  </div>
  <div class="mx-auto grid max-w-screen-lg gap-10 px-4 lg:grid-cols-[1fr_15rem]">
    <article class="prose-rv min-w-0">
      {
        rendered ? (
          <rendered.Content />
        ) : (
          <p>
            This page is being prepared. Questions in the meantime: <a href={`mailto:${publisher.email}`}>{publisher.email}</a>.
          </p>
        )
      }
    </article>
    {
      headings.length > 2 && (
        <nav aria-label="On this page" class="hidden lg:block">
          <div class="sticky top-28">
            <p class="eyebrow">On this page</p>
            <ul class="mt-3 space-y-2 border-l border-base-300 text-sm">
              {headings.map((h) => (
                <li>
                  <a class="-ml-px block border-l border-transparent pl-3 text-base-content/80 hover:border-base-content hover:text-base-content" href={`#${h.slug}`}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      )
    }
  </div>
  <slot />
</Layout>

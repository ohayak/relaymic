---
import CtaButtons from "./CtaButtons.astro";
import PhoneFrame from "./PhoneFrame.astro";
interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Talk in your next meeting on the remote Mac.",
  text = "Install the app on the Mac, add the extension to its browser, and open one address on the device in front of you.",
} = Astro.props;
---

<section class="mx-auto max-w-screen-lg px-4" aria-labelledby="cta-title">
  <div class="band relative overflow-hidden rounded-box bg-neutral px-6 py-10 text-neutral-content md:px-12 md:py-14">
    <div class="grid items-center gap-10 md:grid-cols-[1.5fr_1fr]">
      <div>
        <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-neutral-content/75">
          <span class="dot dot-live"></span> Free · open source · no account
        </p>
        <h2 id="cta-title" class="mt-3 text-3xl font-extrabold leading-tight tracking-tight md:text-5xl">{title}</h2>
        <p class="mt-4 max-w-lg text-lg text-neutral-content/85">{text}</p>
        <div class="mt-8"><CtaButtons inverted /></div>
        <p class="mt-4 text-sm text-neutral-content/75">Coming to the Mac App Store.</p>
      </div>
      <div class="mx-auto hidden w-56 md:block">
        <PhoneFrame name="sender-phone-live" alt="The sender page on a phone, live: microphone, speaker and camera all green." sizes="224px" />
      </div>
    </div>
  </div>
</section>

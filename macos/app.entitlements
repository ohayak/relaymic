<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for RemoteVisio.app (the menu-bar wrapper).
     The app is not sandboxed: it runs the receiver and the uninstall script.
     audio-input: the receiver it launches opens audio input devices, and
     macOS attributes that access to this app as the responsible process. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>

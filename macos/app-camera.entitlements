<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for RemoteVisio.app when it carries the
     camera system extension: a template, macos/assemble-app.sh fills in @TEAM@
     from REMOTEVISIO_TEAM_ID at assembly time (without the extension the app
     needs no entitlement and is signed without any). The app stays
     unsandboxed: it runs the receiver and the uninstall script.
     system-extension.install: lets the app activate the extension. It is a
     restricted entitlement: macOS honours it only with the Developer ID
     provisioning profile embedded in the app (Contents/embedded.provisionprofile),
     whose App ID the application-identifier and team-identifier below must
     match; AMFI kills an app that claims it without the profile. -->
<plist version="1.0">
<dict>
    <key>com.apple.developer.system-extension.install</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>@TEAM@.com.remotevisio.app</string>
    <key>com.apple.developer.team-identifier</key>
    <string>@TEAM@</string>
</dict>
</plist>

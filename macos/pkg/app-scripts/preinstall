#!/bin/sh
# Runs as root before Installer replaces /Applications/RemoteVisio.app in place
# (the component is pinned there and takes any identifier or version, see
# macos/build-pkg.sh). Quit a running copy first and wait for it: swapping
# the bundle under a live receiver, or starting a new one while the old is
# still releasing its audio device, leaves coreaudiod in a state only a
# restart fixes. Its login item is dropped as well, as the console user
# (login items are per user); the new app registers itself again when
# postinstall starts it, unless the person opted out. A previous install
# under the old RelayMic name is retired the same way and removed.
# The camera system extension inside the app needs nothing here: the new app
# version replaces the installed extension itself on its next launch (an
# activation request with the replace action), and deactivating it would take
# the GUI and an administrator's authorization, which an installer has not.

# quit_app NAME: quit a running NAME.app (its menu-bar process) and wait, up to
# 15 s, until nothing runs from the bundle any more.
quit_app() {
    pkill -TERM -f "$1.app/Contents/MacOS/$1" 2>/dev/null || return 0
    i=0
    while [ $i -lt 30 ]; do
        pgrep -f "$1.app/Contents/MacOS/" >/dev/null 2>&1 || break
        sleep 0.5
        i=$((i + 1))
    done
}

# drop_login_item BIN: have the app binary BIN unregister its login item, as
# the person at the console.
console=$(stat -f %Su /dev/console 2>/dev/null || true)
[ "$console" != root ] || console=""
drop_login_item() {
    [ -n "$console" ] && [ -x "$1" ] || return 0
    launchctl asuser "$(id -u "$console")" sudo -u "$console" "$1" --unregister-login-item >/dev/null 2>&1 || true
}

# retire NAME: quit /Applications/NAME.app and drop its login item.
retire() {
    quit_app "$1"
    drop_login_item "/Applications/$1.app/Contents/MacOS/$1"
}

retire RemoteVisio
retire RelayMic
rm -rf /Applications/RelayMic.app
pkgutil --forget com.relaymic.app >/dev/null 2>&1 || true
exit 0

bin/
.context/
.DS_Store

# 落地页（site/）
node_modules/
.wrangler/

# 凭证：任何形式都不进仓库
.dev.vars
.env
*.local

# 私有文档：内部策略、服务器地址、发帖草稿——绝不进公开仓库。
